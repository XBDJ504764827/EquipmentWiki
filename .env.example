# ===================== Server =====================
# HTTP server bind address
SERVER_ADDR=0.0.0.0:8080

# ===================== Frontend =====================
# Backend API base URL used by the Next.js frontend
NEXT_PUBLIC_API_URL=http://localhost:8080

# ===================== Database (PostgreSQL) =====================
# Example: postgres://user:password@localhost:5432/equipmentwiki
DATABASE_URL=

# ===================== Cloudflare R2 =====================
# S3-compatible endpoint for your R2 bucket
R2_ENDPOINT=

# R2 API credentials
R2_ACCESS_KEY=
R2_SECRET_KEY=

# R2 bucket name
R2_BUCKET=
